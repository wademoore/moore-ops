{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Private, versioned Dashboard v2 artifact generation and narrow Pi retrieval",
  "Parameters": {
    "SportsFeedUrl": { "Type": "String" },
    "FamilyContextFileId": { "Type": "String", "NoEcho": true },
    "SourceRevision": { "Type": "String" },
    "FirstDayLevel3Enabled": { "Type": "String", "Default": "0", "AllowedValues": ["0", "1"] },
    "FamilySpotlightEnabled": { "Type": "String", "Default": "0", "AllowedValues": ["0", "1"] },
    "HolidayThemesEnabled": { "Type": "String", "Default": "0", "AllowedValues": ["0", "1"] },
    "MobileArtifactEnabled": { "Type": "String", "Default": "0", "AllowedValues": ["0", "1"] },
    "FirstDayLevel3Departure": { "Type": "String", "Default": "07:30", "AllowedPattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "FirstDayLevel3Handoff": { "Type": "String", "Default": "07:45", "AllowedPattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "FirstDayLevel3Coda": { "Type": "String", "Default": "16:00", "AllowedPattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "ArtifactBucketName": { "Type": "String", "Default": "moore-ops-dashboard-v2-artifacts-0803" },
    "AlertEmail": { "Type": "String", "Default": "", "NoEcho": true }
  },
  "Conditions": {
    "HasAlertEmail": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "AlertEmail" }, ""] }] }
  },
  "Resources": {
    "ArtifactBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": { "Ref": "ArtifactBucketName" },
        "PublicAccessBlockConfiguration": { "BlockPublicAcls": true, "IgnorePublicAcls": true, "BlockPublicPolicy": true, "RestrictPublicBuckets": true },
        "BucketEncryption": { "ServerSideEncryptionConfiguration": [{ "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }] },
        "VersioningConfiguration": { "Status": "Enabled" },
        "LifecycleConfiguration": { "Rules": [{ "Id": "RetainKnownGoodHistory", "Status": "Enabled", "Prefix": "dashboard-v2/", "NoncurrentVersionExpiration": { "NoncurrentDays": 30, "NewerNoncurrentVersions": 10 }, "ExpirationInDays": 45 }] }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "TlsOnlyBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "ArtifactBucket" },
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Sid": "DenyInsecureTransport", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{ "Fn::GetAtt": ["ArtifactBucket", "Arn"] }, { "Fn::Sub": "${ArtifactBucket.Arn}/*" }], "Condition": { "Bool": { "aws:SecureTransport": "false" } } }] }
      }
    },
    "GeneratorFunction": {
      "Type": "AWS::Serverless::Function",
      "Metadata": { "BuildMethod": "esbuild", "BuildProperties": { "EntryPoints": ["dashboard-artifact/generator.js"], "Minify": true, "Sourcemap": false, "Target": "es2022" } },
      "Properties": {
        "CodeUri": "../../",
        "Handler": "dashboard-artifact/generator.handler",
        "Runtime": "nodejs22.x",
        "Architectures": ["arm64"],
        "MemorySize": 1024,
        "Timeout": 180,
        "Environment": { "Variables": { "ARTIFACT_BUCKET": { "Ref": "ArtifactBucket" }, "MANIFEST_KEY": "dashboard-v2/current/manifest.json", "SPORTS_FEED_URL": { "Ref": "SportsFeedUrl" }, "SOURCE_REVISION": { "Ref": "SourceRevision" }, "FIRST_DAY_LEVEL3_ENABLED": { "Ref": "FirstDayLevel3Enabled" }, "FIRST_DAY_LEVEL3_DEPARTURE": { "Ref": "FirstDayLevel3Departure" }, "FIRST_DAY_LEVEL3_HANDOFF": { "Ref": "FirstDayLevel3Handoff" }, "FIRST_DAY_LEVEL3_CODA": { "Ref": "FirstDayLevel3Coda" }, "FAMILY_SPOTLIGHT_ENABLED": { "Ref": "FamilySpotlightEnabled" }, "HOLIDAY_THEMES_ENABLED": { "Ref": "HolidayThemesEnabled" }, "MOBILE_ARTIFACT_ENABLED": { "Ref": "MobileArtifactEnabled" }, "MOBILE_MANIFEST_KEY": "dashboard-mobile/current/manifest.json", "DRIVE_FAMILY_CONTEXT_FILE_ID": { "Ref": "FamilyContextFileId" }, "GOOGLE_AUTH_READ_ONLY": "1", "DASHBOARD_ASSET_DIR": "/var/task/assets-v2", "DASHBOARD_FIRST_DAY_ASSET_DIR": "/var/task/assets-first-day", "DASHBOARD_DATA_DIR": "/var/task/data" } },
        "Policies": [{ "Version": "2012-10-17", "Statement": [
          { "Effect": "Allow", "Action": ["secretsmanager:GetSecretValue"], "Resource": [{ "Fn::Sub": "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:moore-ops/google-credentials-*" }, { "Fn::Sub": "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:moore-ops/google-oauth-token-*" }] },
          { "Effect": "Allow", "Action": ["s3:PutObject"], "Resource": { "Fn::Sub": "${ArtifactBucket.Arn}/dashboard-v2/*" } },
          { "Effect": "Allow", "Action": ["s3:PutObject"], "Resource": { "Fn::Sub": "${ArtifactBucket.Arn}/dashboard-mobile/*" } }
        ] }],
        "Events": {
          "DailyFullData": { "Type": "ScheduleV2", "Properties": { "ScheduleExpression": "cron(35 4 * * ? *)", "ScheduleExpressionTimezone": "America/New_York", "FlexibleTimeWindow": { "Mode": "OFF" }, "RetryPolicy": { "MaximumRetryAttempts": 2, "MaximumEventAgeInSeconds": 3600 } } },
          "DaytimeRefresh": { "Type": "ScheduleV2", "Properties": { "ScheduleExpression": "cron(10 8,12,16,20 * * ? *)", "ScheduleExpressionTimezone": "America/New_York", "FlexibleTimeWindow": { "Mode": "OFF" }, "RetryPolicy": { "MaximumRetryAttempts": 2, "MaximumEventAgeInSeconds": 3600 } } }
        }
      }
    },
    "GeneratorLogGroup": { "Type": "AWS::Logs::LogGroup", "Properties": { "LogGroupName": { "Fn::Sub": "/aws/lambda/${GeneratorFunction}" }, "RetentionInDays": 30 } },
    "GeneratorAlertTopic": { "Type": "AWS::SNS::Topic" },
    "GeneratorAlertSubscription": { "Type": "AWS::SNS::Subscription", "Condition": "HasAlertEmail", "Properties": { "TopicArn": { "Ref": "GeneratorAlertTopic" }, "Protocol": "email", "Endpoint": { "Ref": "AlertEmail" } } },
    "DisplayPublishedMetricFilter": { "Type": "AWS::Logs::MetricFilter", "Properties": { "LogGroupName": { "Ref": "GeneratorLogGroup" }, "FilterPattern": "\"dashboard_artifact_generation_succeeded\"", "MetricTransformations": [{ "MetricNamespace": "MooreOps/DashboardV2", "MetricName": "DisplayPublished", "MetricValue": "1" }] } },
    "MobileFailedMetricFilter": { "Type": "AWS::Logs::MetricFilter", "Properties": { "LogGroupName": { "Ref": "GeneratorLogGroup" }, "FilterPattern": "\"dashboard_mobile_generation_failed\"", "MetricTransformations": [{ "MetricNamespace": "MooreOps/DashboardV2", "MetricName": "MobileGenerationFailed", "MetricValue": "1" }] } },
    "GeneratorFailedAlarm": { "Type": "AWS::CloudWatch::Alarm", "Properties": { "AlarmName": "moore-ops-dashboard-v2-generator-failed", "Namespace": "AWS/Lambda", "MetricName": "Errors", "Dimensions": [{ "Name": "FunctionName", "Value": { "Ref": "GeneratorFunction" } }], "Statistic": "Sum", "Period": 3600, "EvaluationPeriods": 1, "Threshold": 3, "ComparisonOperator": "GreaterThanOrEqualToThreshold", "TreatMissingData": "notBreaching", "AlarmActions": [{ "Ref": "GeneratorAlertTopic" }] } },
    "GeneratorStaleAlarm": { "Type": "AWS::CloudWatch::Alarm", "Properties": { "AlarmName": "moore-ops-dashboard-v2-generator-stale", "Namespace": "MooreOps/DashboardV2", "MetricName": "DisplayPublished", "Statistic": "Sum", "Period": 3600, "EvaluationPeriods": 9, "DatapointsToAlarm": 9, "Threshold": 1, "ComparisonOperator": "LessThanThreshold", "TreatMissingData": "breaching", "AlarmActions": [{ "Ref": "GeneratorAlertTopic" }], "OKActions": [{ "Ref": "GeneratorAlertTopic" }] } },
    "MobileFailedAlarm": { "Type": "AWS::CloudWatch::Alarm", "Properties": { "AlarmName": "moore-ops-dashboard-v2-mobile-failed", "Metrics": [
      { "Id": "display", "MetricStat": { "Metric": { "Namespace": "MooreOps/DashboardV2", "MetricName": "DisplayPublished" }, "Period": 3600, "Stat": "Sum" }, "ReturnData": false },
      { "Id": "mobile", "MetricStat": { "Metric": { "Namespace": "MooreOps/DashboardV2", "MetricName": "MobileGenerationFailed" }, "Period": 3600, "Stat": "Sum" }, "ReturnData": false },
      { "Id": "wallPublishedMobileFailed", "Expression": "IF(FILL(display, 0) > 0 AND FILL(mobile, 0) > 0, 1, 0)", "ReturnData": true }
    ], "EvaluationPeriods": 1, "Threshold": 1, "ComparisonOperator": "GreaterThanOrEqualToThreshold", "TreatMissingData": "notBreaching", "AlarmActions": [{ "Ref": "GeneratorAlertTopic" }] } },
    "PiReader": { "Type": "AWS::IAM::User", "Properties": { "UserName": "moore-ops-dashboard-v2-pi-reader-0803", "Policies": [{ "PolicyName": "ReadOnlyDashboardArtifacts", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["s3:GetObject", "s3:GetObjectVersion"], "Resource": { "Fn::Sub": "${ArtifactBucket.Arn}/dashboard-v2/*" } }] } }] } }
  },
  "Outputs": {
    "ArtifactBucket": { "Value": { "Ref": "ArtifactBucket" } },
    "GeneratorFunction": { "Value": { "Ref": "GeneratorFunction" } },
    "PiReaderUser": { "Value": { "Ref": "PiReader" } },
    "ManifestKey": { "Value": "dashboard-v2/current/manifest.json" }
  }
}
