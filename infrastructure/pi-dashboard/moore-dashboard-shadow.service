[Unit]
Description=Moore Dashboard v2 NOW/NEXT shadow preview
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
ExecStart=/usr/bin/python3 -m http.server 4174 --bind 127.0.0.1 --directory /home/pi/moore-dashboard/shadow
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/pi/moore-dashboard/shadow

[Install]
WantedBy=multi-user.target
