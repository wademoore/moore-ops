      expected: |-
        name: Deploy Dashboard v2 artifact generator
        
        on:
          push:
            branches:
              - main
            paths:
              - '.github/workflows/deploy-dashboard-v2-artifact.yml'
              - 'dashboard-artifact/**'
              - 'digest/**'
              - 'render/**'
              - 'sports/**'
              - 'data/**'
              - '*.js'
              - 'package.json'
              - 'package-lock.json'
              - 'infrastructure/dashboard-artifact-refresh/**'
              - 'scripts/prepare-dashboard-artifact-package.mjs'
              - 'scripts/validate-dashboard-artifact-deployment.mjs'
              - 'scripts/validate-dashboard-artifact-package.mjs'
          workflow_dispatch:
        
        permissions:
          id-token: write
          contents: read
        
        concurrency:
          group: deploy-dashboard-v2-artifact
          cancel-in-progress: false
        
        jobs:
          deploy:
            runs-on: ubuntu-latest
            steps:
              - name: Check safe deploy window
                run: |
                  HOUR=$(TZ="America/New_York" date +%H)
                  MIN=$(TZ="America/New_York" date +%M)
                  if [ "$HOUR" -eq 3 ] && [ "$MIN" -ge 30 ]; then
                    echo "Deploy blocked — too close to the 4 AM generation"
                    exit 1
                  fi
                  if [ "$HOUR" -eq 4 ] && [ "$MIN" -le 30 ]; then
                    echo "Deploy blocked — generation may be running"
                    exit 1
                  fi
        
              - name: Resolve Family Spotlight kill switch
                env:
                  # Read through env, never interpolated into the script body: a
                  # repository variable is attacker-controllable text and `${{ }}` inside
                  # a run block is substituted before bash ever sees it.
                  FAMILY_SPOTLIGHT_ENABLED: ${{ vars.FAMILY_SPOTLIGHT_ENABLED }}
                run: |
                  RAW="${FAMILY_SPOTLIGHT_ENABLED:-}"
                  # Trim whitespace so a present-but-blank variable counts as absent.
                  VALUE="$(printf '%s' "$RAW" | tr -d '[:space:]')"
                  if [ -z "$VALUE" ]; then
                    VALUE=0
                    echo "FAMILY_SPOTLIGHT_ENABLED is absent or blank - failing closed to 0"
                  fi
                  case "$VALUE" in
                    0|1) ;;
                    *)
                      echo "::error::FAMILY_SPOTLIGHT_ENABLED must be exactly 0 or 1, got '$VALUE' - refusing to deploy"
                      exit 1
                      ;;
                  esac
                  echo "SPOTLIGHT_ENABLED=$VALUE" >> "$GITHUB_ENV"
                  echo "Family Spotlight kill switch will be deployed as $VALUE"
        
              - name: Resolve Holiday Themes kill switch
                env:
                  # Read through env, never interpolated into the script body: a
                  # repository variable is editable text and `${{ }}` inside a run block
                  # is substituted before bash ever sees it. Independent of
                  # FAMILY_SPOTLIGHT_ENABLED - neither switch reads or writes the other.
                  HOLIDAY_THEMES_ENABLED: ${{ vars.HOLIDAY_THEMES_ENABLED }}
                run: |
                  RAW="${HOLIDAY_THEMES_ENABLED:-}"
                  # Trim whitespace so a present-but-blank variable counts as absent.
                  VALUE="$(printf '%s' "$RAW" | tr -d '[:space:]')"
                  if [ -z "$VALUE" ]; then
                    VALUE=0
                    echo "HOLIDAY_THEMES_ENABLED is absent or blank - failing closed to 0"
                  fi
                  case "$VALUE" in
                    0|1) ;;
                    *)
                      echo "::error::HOLIDAY_THEMES_ENABLED must be exactly 0 or 1, got '$VALUE' - refusing to deploy"
                      exit 1
                      ;;
                  esac
                  echo "HOLIDAY_ENABLED=$VALUE" >> "$GITHUB_ENV"
                  echo "Holiday Themes kill switch will be deployed as $VALUE"
        
              - name: Resolve mobile artifact kill switch
                env:
                  # Read through env, never interpolated into the script body: a
                  # repository variable is editable text and `${{ }}` inside a run block
                  # is substituted before bash ever sees it. Sourced
                  # from its own repository variable and no other - the two existing
                  # switches are read here neither as a fallback nor as a default.
                  MOBILE_ARTIFACT_ENABLED: ${{ vars.MOBILE_ARTIFACT_ENABLED }}
                run: |
                  RAW="${MOBILE_ARTIFACT_ENABLED:-}"
                  # Trim whitespace so a present-but-blank variable counts as absent.
                  VALUE="$(printf '%s' "$RAW" | tr -d '[:space:]')"
                  if [ -z "$VALUE" ]; then
                    VALUE=0
                    echo "MOBILE_ARTIFACT_ENABLED is absent or blank - failing closed to 0"
                  fi
                  case "$VALUE" in
                    0|1) ;;
                    *)
                      echo "::error::MOBILE_ARTIFACT_ENABLED must be exactly 0 or 1, got '$VALUE' - refusing to deploy"
                      exit 1
                      ;;
                  esac
                  echo "MOBILE_ENABLED=$VALUE" >> "$GITHUB_ENV"
                  echo "Mobile artifact kill switch will be deployed as $VALUE"
        
              - name: Checkout
                uses: actions/checkout@v4
        
              - name: Setup Node
                uses: actions/setup-node@v4
                with:
                  node-version: '22'
                  cache: npm
        
              - name: Setup SAM
                uses: aws-actions/setup-sam@v2
        
              - name: Install dependencies
                run: npm ci
        
              - name: Validate deployment dependency coverage
                run: npm run validate:dashboard-artifact-deployment
        
              - name: Build and validate generator package
                run: |
                  npm run build:dashboard-artifact
                  npm run validate:dashboard-artifact-package
        
              - name: Configure AWS credentials
                uses: aws-actions/configure-aws-credentials@v4
                with:
                  role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
                  aws-region: ${{ secrets.AWS_REGION }}
        
              - name: Deploy integrated generator revision
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                  PACKAGE_BUCKET: moore-ops-lambda
                run: |
                  sam deploy \
                    --template-file .aws-sam/build/template.yaml \
                    --stack-name "$STACK_NAME" \
                    --s3-bucket "$PACKAGE_BUCKET" \
                    --capabilities CAPABILITY_NAMED_IAM \
                    --no-confirm-changeset \
                    --no-fail-on-empty-changeset \
                    --parameter-overrides \
                      "SourceRevision=$GITHUB_SHA" \
                      "FamilySpotlightEnabled=$SPOTLIGHT_ENABLED" \
                      "HolidayThemesEnabled=$HOLIDAY_ENABLED" \
                      "MobileArtifactEnabled=$MOBILE_ENABLED"
        
              - name: Verify deployed source revision
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                run: |
                  DEPLOYED=$(aws cloudformation describe-stacks --stack-name "$STACK_NAME" --query "Stacks[0].Parameters[?ParameterKey=='SourceRevision'].ParameterValue | [0]" --output text)
                  test "$DEPLOYED" = "$GITHUB_SHA"
                  echo "Dashboard v2 artifact generator deployed from $GITHUB_SHA"
        
              - name: Verify deployed Family Spotlight kill switch
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                run: |
                  # Selects exactly one parameter: no other stack parameter is read or printed.
                  DEPLOYED=$(aws cloudformation describe-stacks --stack-name "$STACK_NAME" --query "Stacks[0].Parameters[?ParameterKey=='FamilySpotlightEnabled'].ParameterValue | [0]" --output text)
                  if [ -z "$DEPLOYED" ] || [ "$DEPLOYED" = "None" ]; then
                    echo "::error::FamilySpotlightEnabled is absent from the deployed stack"
                    exit 1
                  fi
                  if [ "$DEPLOYED" != "$SPOTLIGHT_ENABLED" ]; then
                    echo "::error::FamilySpotlightEnabled mismatch - intended $SPOTLIGHT_ENABLED, deployed $DEPLOYED"
                    exit 1
                  fi
                  echo "Family Spotlight kill switch verified as $DEPLOYED"
        
              - name: Verify deployed Holiday Themes kill switch
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                run: |
                  # Selects exactly one parameter: no other stack parameter is read or printed.
                  DEPLOYED=$(aws cloudformation describe-stacks --stack-name "$STACK_NAME" --query "Stacks[0].Parameters[?ParameterKey=='HolidayThemesEnabled'].ParameterValue | [0]" --output text)
                  if [ -z "$DEPLOYED" ] || [ "$DEPLOYED" = "None" ]; then
                    echo "::error::HolidayThemesEnabled is absent from the deployed stack"
                    exit 1
                  fi
                  if [ "$DEPLOYED" != "$HOLIDAY_ENABLED" ]; then
                    echo "::error::HolidayThemesEnabled mismatch - intended $HOLIDAY_ENABLED, deployed $DEPLOYED"
                    exit 1
                  fi
                  echo "Holiday Themes kill switch verified as $DEPLOYED"
        
              - name: Verify deployed mobile artifact kill switch
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                run: |
                  # Selects exactly one parameter: no other stack parameter is read or printed.
                  DEPLOYED=$(aws cloudformation describe-stacks --stack-name "$STACK_NAME" --query "Stacks[0].Parameters[?ParameterKey=='MobileArtifactEnabled'].ParameterValue | [0]" --output text)
                  if [ -z "$DEPLOYED" ] || [ "$DEPLOYED" = "None" ]; then
                    echo "::error::MobileArtifactEnabled is absent from the deployed stack"
                    exit 1
                  fi
                  if [ "$DEPLOYED" != "$MOBILE_ENABLED" ]; then
                    echo "::error::MobileArtifactEnabled mismatch - intended $MOBILE_ENABLED, deployed $DEPLOYED"
                    exit 1
                  fi
                  echo "Mobile artifact kill switch verified as $DEPLOYED"
        
      actual: |-
        name: Deploy Dashboard v2 artifact generator
        
        on:
          push:
            branches:
              - main
            paths:
              - '.github/workflows/deploy-dashboard-v2-artifact.yml'
              - 'dashboard-artifact/**'
              - 'digest/**'
              - 'render/**'
              - 'sports/**'
              - 'data/**'
              - '*.js'
              - 'package.json'
              - 'package-lock.json'
              - 'infrastructure/dashboard-artifact-refresh/**'
              - 'scripts/prepare-dashboard-artifact-package.mjs'
              - 'scripts/validate-dashboard-artifact-deployment.mjs'
              - 'scripts/validate-dashboard-artifact-package.mjs'
          workflow_dispatch:
        
        permissions:
          id-token: write
          contents: read
        
        concurrency:
          group: deploy-dashboard-v2-artifact
          cancel-in-progress: false
        
        jobs:
          deploy:
            runs-on: ubuntu-latest
            steps:
              - name: Check safe deploy window
                run: |
                  HOUR=$(TZ="America/New_York" date +%H)
                  MIN=$(TZ="America/New_York" date +%M)
                  if [ "$HOUR" -eq 3 ] && [ "$MIN" -ge 30 ]; then
                    echo "Deploy blocked — too close to the 4 AM generation"
                    exit 1
                  fi
                  if [ "$HOUR" -eq 4 ] && [ "$MIN" -le 30 ]; then
                    echo "Deploy blocked — generation may be running"
                    exit 1
                  fi
        
              - name: Resolve Family Spotlight kill switch
                env:
                  # Read through env, never interpolated into the script body: a
                  # repository variable is attacker-controllable text and `${{ }}` inside
                  # a run block is substituted before bash ever sees it.
                  FAMILY_SPOTLIGHT_ENABLED: ${{ vars.FAMILY_SPOTLIGHT_ENABLED }}
                run: |
                  RAW="${FAMILY_SPOTLIGHT_ENABLED:-}"
                  # Trim whitespace so a present-but-blank variable counts as absent.
                  VALUE="$(printf '%s' "$RAW" | tr -d '[:space:]')"
                  if [ -z "$VALUE" ]; then
                    VALUE=0
                    echo "FAMILY_SPOTLIGHT_ENABLED is absent or blank - failing closed to 0"
                  fi
                  case "$VALUE" in
                    0|1) ;;
                    *)
                      echo "::error::FAMILY_SPOTLIGHT_ENABLED must be exactly 0 or 1, got '$VALUE' - refusing to deploy"
                      exit 1
                      ;;
                  esac
                  echo "SPOTLIGHT_ENABLED=$VALUE" >> "$GITHUB_ENV"
                  echo "Family Spotlight kill switch will be deployed as $VALUE"
        
              - name: Resolve Holiday Themes kill switch
                env:
                  # Read through env, never interpolated into the script body: a
                  # repository variable is editable text and `${{ }}` inside a run block
                  # is substituted before bash ever sees it. Independent of
                  # FAMILY_SPOTLIGHT_ENABLED - neither switch reads or writes the other.
                  HOLIDAY_THEMES_ENABLED: ${{ vars.HOLIDAY_THEMES_ENABLED }}
                run: |
                  RAW="${HOLIDAY_THEMES_ENABLED:-}"
                  # Trim whitespace so a present-but-blank variable counts as absent.
                  VALUE="$(printf '%s' "$RAW" | tr -d '[:space:]')"
                  if [ -z "$VALUE" ]; then
                    VALUE=0
                    echo "HOLIDAY_THEMES_ENABLED is absent or blank - failing closed to 0"
                  fi
                  case "$VALUE" in
                    0|1) ;;
                    *)
                      echo "::error::HOLIDAY_THEMES_ENABLED must be exactly 0 or 1, got '$VALUE' - refusing to deploy"
                      exit 1
                      ;;
                  esac
                  echo "HOLIDAY_ENABLED=$VALUE" >> "$GITHUB_ENV"
                  echo "Holiday Themes kill switch will be deployed as $VALUE"
        
              - name: Resolve mobile artifact kill switch
                env:
                  # Read through env, never interpolated into the script body: a
                  # repository variable is editable text and `${{ }}` inside a run block
                  # is substituted before bash ever sees it. Sourced
                  # from its own repository variable and no other - the two existing
                  # switches are read here neither as a fallback nor as a default.
                  MOBILE_ARTIFACT_ENABLED: ${{ vars.MOBILE_ARTIFACT_ENABLED }}
                run: |
                  RAW="${MOBILE_ARTIFACT_ENABLED:-}"
                  # Trim whitespace so a present-but-blank variable counts as absent.
                  VALUE="$(printf '%s' "$RAW" | tr -d '[:space:]')"
                  if [ -z "$VALUE" ]; then
                    VALUE=0
                    echo "MOBILE_ARTIFACT_ENABLED is absent or blank - failing closed to 0"
                  fi
                  case "$VALUE" in
                    0|1) ;;
                    *)
                      echo "::error::MOBILE_ARTIFACT_ENABLED must be exactly 0 or 1, got '$VALUE' - refusing to deploy"
                      exit 1
                      ;;
                  esac
                  echo "MOBILE_ENABLED=$VALUE" >> "$GITHUB_ENV"
                  echo "Mobile artifact kill switch will be deployed as $VALUE"
        
              - name: Checkout
                uses: actions/checkout@v4
        
              - name: Setup Node
                uses: actions/setup-node@v4
                with:
                  node-version: '22'
                  cache: npm
        
              - name: Setup SAM
                uses: aws-actions/setup-sam@v2
        
              - name: Install dependencies
                run: npm ci
        
              - name: Validate deployment dependency coverage
                run: npm run validate:dashboard-artifact-deployment
        
              - name: Build and validate generator package
                run: |
                  npm run build:dashboard-artifact
                  npm run validate:dashboard-artifact-package
        
              - name: Configure AWS credentials
                uses: aws-actions/configure-aws-credentials@v4
                with:
                  role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
                  aws-region: ${{ secrets.AWS_REGION }}
        
              - name: Deploy integrated generator revision
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                  PACKAGE_BUCKET: moore-ops-lambda
                run: |
                  sam deploy \
                    --template-file .aws-sam/build/template.yaml \
                    --stack-name "$STACK_NAME" \
                    --s3-bucket "$PACKAGE_BUCKET" \
                    --capabilities CAPABILITY_NAMED_IAM \
                    --no-confirm-changeset \
                    --no-fail-on-empty-changeset \
                    --parameter-overrides \
                      "SourceRevision=$GITHUB_SHA" \
                      "FamilySpotlightEnabled=$SPOTLIGHT_ENABLED" \
                      "HolidayThemesEnabled=$HOLIDAY_ENABLED" \
                      "MobileArtifactEnabled=$MOBILE_ENABLED"
        
              - name: Verify deployed source revision
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                run: |
                  DEPLOYED=$(aws cloudformation describe-stacks --stack-name "$STACK_NAME" --query "Stacks[0].Parameters[?ParameterKey=='SourceRevision'].ParameterValue | [0]" --output text)
                  test "$DEPLOYED" = "$GITHUB_SHA"
                  echo "Dashboard v2 artifact generator deployed from $GITHUB_SHA"
        
              - name: Verify deployed Family Spotlight kill switch
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                run: |
                  # Selects exactly one parameter: no other stack parameter is read or printed.
                  DEPLOYED=$(aws cloudformation describe-stacks --stack-name "$STACK_NAME" --query "Stacks[0].Parameters[?ParameterKey=='FamilySpotlightEnabled'].ParameterValue | [0]" --output text)
                  if [ -z "$DEPLOYED" ] || [ "$DEPLOYED" = "None" ]; then
                    echo "::error::FamilySpotlightEnabled is absent from the deployed stack"
                    exit 1
                  fi
                  if [ "$DEPLOYED" != "$SPOTLIGHT_ENABLED" ]; then
                    echo "::error::FamilySpotlightEnabled mismatch - intended $SPOTLIGHT_ENABLED, deployed $DEPLOYED"
                    exit 1
                  fi
                  echo "Family Spotlight kill switch verified as $DEPLOYED"
        
              - name: Verify deployed Holiday Themes kill switch
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                run: |
                  # Selects exactly one parameter: no other stack parameter is read or printed.
                  DEPLOYED=$(aws cloudformation describe-stacks --stack-name "$STACK_NAME" --query "Stacks[0].Parameters[?ParameterKey=='HolidayThemesEnabled'].ParameterValue | [0]" --output text)
                  if [ -z "$DEPLOYED" ] || [ "$DEPLOYED" = "None" ]; then
                    echo "::error::HolidayThemesEnabled is absent from the deployed stack"
                    exit 1
                  fi
                  if [ "$DEPLOYED" != "$HOLIDAY_ENABLED" ]; then
                    echo "::error::HolidayThemesEnabled mismatch - intended $HOLIDAY_ENABLED, deployed $DEPLOYED"
                    exit 1
                  fi
                  echo "Holiday Themes kill switch verified as $DEPLOYED"
        
              - name: Verify deployed mobile artifact kill switch
                env:
                  STACK_NAME: moore-ops-dashboard-v2-artifact-refresh
                run: |
                  # Selects exactly one parameter: no other stack parameter is read or printed.
                  DEPLOYED=$(aws cloudformation describe-stacks --stack-name "$STACK_NAME" --query "Stacks[0].Parameters[?ParameterKey=='MobileArtifactEnabled'].ParameterValue | [0]" --output text)
                  if [ -z "$DEPLOYED" ] || [ "$DEPLOYED" = "None" ]; then
                    echo "::error::MobileArtifactEnabled is absent from the deployed stack"
                    exit 1
                  fi
                  if [ "$DEPLOYED" != "$MOBILE_ENABLED" ]; then
                    echo "::error::MobileArtifactEnabled mismatch - intended $MOBILE_ENABLED, deployed $DEPLOYED"
                    exit 1
                  fi
                  echo "Mobile artifact kill switch verified as $DEPLOYED"
        
